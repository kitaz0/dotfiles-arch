general {
    hide_cursor = true
}
background {
    monitor =
    color = rgba({{background|hex}}ff)
}
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgba({{foreground|hex}}ff)
    font_size = 64
    font_family = Noto Sans
    position = 0, 120
    halign = center
    valign = center
}
input-field {
    monitor =
    size = 300, 54
    outline_thickness = 2
    outer_color = rgba({{border|hex}}ff)
    inner_color = rgba({{surface|hex}}ff)
    font_color = rgba({{foreground|hex}}ff)
    check_color = rgba({{accent|hex}}ff)
    fail_color = rgba({{red|hex}}ff)
    placeholder_text = <i>Password</i>
    rounding = 7
    position = 0, -40
    halign = center
    valign = center
}
