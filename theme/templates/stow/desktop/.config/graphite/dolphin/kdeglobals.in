[General]
ColorScheme=Gruvbox
font=Noto Sans,10,-1,5,50,0,0,0,0,0
fixed=JetBrainsMono Nerd Font,11,-1,5,50,0,0,0,0,0
TerminalApplication[$e]="$HOME/.local/lib/graphite/terminal.sh"
TerminalService=
[KDE]
widgetStyle=Breeze
[Icons]
Theme=breeze-dark
[Colors:Window]
BackgroundNormal={{background|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:View]
BackgroundNormal={{surface|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:Button]
BackgroundNormal={{elevated|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:Selection]
BackgroundNormal={{accent|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{background|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:Tooltip]
BackgroundNormal={{surface|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:Complementary]
BackgroundNormal={{background|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
DecorationFocus={{accent|rgb}}
DecorationHover={{secondary|rgb}}
[Colors:Header]
BackgroundNormal={{background|rgb}}
BackgroundAlternate={{elevated|rgb}}
ForegroundNormal={{foreground|rgb}}
ForegroundInactive={{muted|rgb}}
ForegroundActive={{accent|rgb}}
ForegroundLink={{secondary|rgb}}
ForegroundVisited={{tertiary|rgb}}
ForegroundNegative={{red|rgb}}
ForegroundNeutral={{secondary|rgb}}
ForegroundPositive={{green|rgb}}
