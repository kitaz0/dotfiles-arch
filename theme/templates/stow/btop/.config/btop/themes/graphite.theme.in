# Original Graphite palette; btop's native theme keys.
theme[main_bg]="{{background}}"
theme[main_fg]="{{foreground}}"
theme[title]="{{foreground}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{accent}}"
theme[selected_fg]="{{background}}"
theme[inactive_fg]="{{muted}}"
theme[graph_text]="{{muted}}"
theme[proc_misc]="{{tertiary}}"
theme[cpu_box]="{{accent}}"
theme[mem_box]="{{secondary}}"
theme[net_box]="{{secondary}}"
theme[proc_box]="{{tertiary}}"
theme[div_line]="{{border}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{secondary}}"
theme[temp_end]="{{red}}"
theme[cpu_start]="{{orange_dim}}"
theme[cpu_mid]="{{accent}}"
theme[cpu_end]="{{secondary}}"
theme[free_start]="{{green_dim}}"
theme[free_mid]="{{green}}"
theme[free_end]="{{green}}"
theme[cached_start]="{{gold}}"
theme[cached_mid]="{{secondary}}"
theme[cached_end]="{{foreground}}"
theme[available_start]="{{green_dim}}"
theme[available_mid]="{{green}}"
theme[available_end]="{{secondary}}"
theme[used_start]="{{purple_dim}}"
theme[used_mid]="{{tertiary}}"
theme[used_end]="{{red}}"
theme[download_start]="{{gold}}"
theme[download_mid]="{{secondary}}"
theme[download_end]="{{foreground}}"
theme[upload_start]="{{purple_dim}}"
