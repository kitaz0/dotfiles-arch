{
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 360,
  "notification-window-width": 360,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "notification-grouping": false,
  "hide-on-action": true,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    }
  }
}
